generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  password     String
  name         String    @default("")
  role         String    @default("client")
  clientStatus String    @default("nouveau")
  active       Boolean   @default(true)
  restaurant   String    @default("")
  city         String    @default("")
  createdAt    DateTime  @default(now())
  messages     Message[]
}

model Lead {
  id         String   @id @default(cuid())
  name       String
  email      String
  restaurant String
  message    String
  status     String   @default("nouveau")
  notes      String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Invoice {
  id           String   @id @default(cuid())
  number       String   @unique
  clientName   String
  clientEmail  String   @default("")
  clientUserId String?
  items        String
  subtotal     Float    @default(0)
  tva          Float    @default(0)
  total        Float    @default(0)
  status       String   @default("brouillon")
  dueDate      String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Prompt {
  id        String   @id @default(cuid())
  title     String
  category  String   @default("général")
  content   String
  tags      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Quote {
  id             String   @id @default(cuid())
  number         String   @unique
  clientName     String
  restaurantName String   @default("")
  city           String   @default("")
  clientEmail    String   @default("")
  status         String   @default("brouillon")
  items          String   @default("[]")
  subtotal       Float    @default(0)
  tva            Float    @default(7.7)
  total          Float    @default(0)
  validUntil     String   @default("")
  notes          String   @default("")
  clientUserId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Message {
  id         String   @id @default(cuid())
  clientId   String
  senderRole String
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  client     User     @relation(fields: [clientId], references: [id])
}
